---
import { projects } from '../data/projects';
---

<section class="page-shell section" aria-labelledby="projects-title">
  <div class="section-heading">
    <div>
      <p class="eyebrow">Selected work</p>
      <h2 id="projects-title">Built to be used, inspected, and improved.</h2>
    </div>
    <a class="text-link" href="/projects/">All project details →</a>
  </div>
  <div class="card-grid">
    {projects.map((project) => (
      <article class="card project-card">
        <div class="project-meta"><span>{project.language}</span><span aria-hidden="true">↗</span></div>
        <h3><a href={project.href}>{project.name}</a></h3>
        <p>{project.description}</p>
        <ul class="pill-list" aria-label={`${project.name} focus areas`}>
          {project.focus.map((item) => <li class="pill">{item}</li>)}
        </ul>
      </article>
    ))}
  </div>
</section>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    min-height: 21rem;
  }

  .project-card p {
    color: var(--color-muted);
  }

  .project-card .pill-list {
    margin-top: auto;
  }

  .project-card h3 a {
    text-decoration: none;
  }

  .project-card h3 a::after {
    position: absolute;
    inset: 0;
    content: '';
  }

  .project-meta {
    display: flex;
    justify-content: space-between;
    margin-bottom: 4rem;
    color: var(--color-primary-deep);
    font-size: .78rem;
    font-weight: 800;
    letter-spacing: .08em;
    text-transform: uppercase;
  }
</style>
