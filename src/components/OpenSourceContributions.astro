---
import { contributions } from '../data/contributions';
---

<section class="page-shell section" aria-labelledby="contributions-title">
  <div class="contribution-panel">
    <div class="contribution-intro">
      <p class="eyebrow">Open source</p>
      <h2 id="contributions-title">Small patches, shared systems.</h2>
      <p class="lede">Merged contributions to tools and interfaces used by a wider community.</p>
    </div>
    <ol class="contribution-list">
      {contributions.map((item) => (
        <li>
          <a href={item.href}>
            <span class="repo-name">{item.repository}</span>
            <strong>{item.title}</strong>
            <span class="pr-number">{item.pullRequest} ↗</span>
          </a>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .contribution-panel {
    display: grid;
    grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr);
    gap: clamp(2rem, 7vw, 6rem);
    border-radius: 2rem;
    padding: clamp(1.7rem, 6vw, 4.5rem);
    background: linear-gradient(135deg, #edf3ff, #f7f4ff 52%, #eafbf8);
  }

  .contribution-intro h2 {
    max-width: 10ch;
  }

  .contribution-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .contribution-list li + li {
    border-top: 1px solid rgba(112,129,157,.22);
  }

  .contribution-list a {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: .35rem 1rem;
    padding: 1.25rem .25rem;
    text-decoration: none;
  }

  .repo-name {
    grid-column: 1 / -1;
    color: var(--color-muted);
    font-size: .72rem;
    font-weight: 700;
  }

  .pr-number {
    color: var(--color-primary-deep);
    font-size: .85rem;
    font-weight: 800;
  }

  @media (max-width: 52rem) {
    .contribution-panel {
      grid-template-columns: 1fr;
    }
  }
</style>
