---
import type { CollectionEntry } from 'astro:content';
import EmptyNotes from './EmptyNotes.astro';

interface Props {
  notes: CollectionEntry<'notes'>[];
}

const { notes } = Astro.props;
---

<section class="page-shell section" aria-labelledby="latest-notes-title">
  <div class="section-heading">
    <div>
      <p class="eyebrow">Latest notes</p>
      <h2 id="latest-notes-title">Field notes from the work.</h2>
    </div>
    {notes.length > 0 && <a class="text-link" href="/notes/">View all notes →</a>}
  </div>
  {notes.length === 0 ? <EmptyNotes /> : (
    <div class="card-grid">
      {notes.slice(0, 3).map((note) => (
        <article class="card">
          <p class="eyebrow">{note.data.language}</p>
          <h3><a href={`/notes/${note.id}/`}>{note.data.title}</a></h3>
          <p>{note.data.description}</p>
        </article>
      ))}
    </div>
  )}
</section>
