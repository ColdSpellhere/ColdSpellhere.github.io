---
import { navigation, site } from '../data/site';

const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="page-shell header-inner">
    <a class="brand" href="/" aria-label={`${site.name} home`}>
      <span class="brand-mark" aria-hidden="true"></span>
      <span>{site.name}</span>
    </a>

    <nav class="site-nav" aria-label="Primary navigation">
      {navigation.map((item) => (
        <a href={item.href} aria-current={currentPath.startsWith(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
      <a href="/search/" aria-current={currentPath === '/search/' ? 'page' : undefined}>Search</a>
      <a class="github-link" href={site.github} aria-label="ColdSpell on GitHub">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <path fill="currentColor" d="M12 .8a11.4 11.4 0 0 0-3.6 22.2c.6.1.8-.2.8-.6v-2.2c-3.3.7-4-1.4-4-1.4-.5-1.4-1.3-1.7-1.3-1.7-1.1-.8.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1.1 1.8 2.8 1.3 3.4 1 .1-.8.4-1.3.8-1.6-2.6-.3-5.4-1.3-5.4-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.2 1.2a11 11 0 0 1 5.8 0c2.2-1.5 3.2-1.2 3.2-1.2.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.4 5.7.4.4.8 1.1.8 2.2v3.2c0 .4.2.7.8.6A11.4 11.4 0 0 0 12 .8Z" />
        </svg>
      </a>
    </nav>
  </div>
</header>
